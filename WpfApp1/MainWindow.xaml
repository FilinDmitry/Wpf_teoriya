<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="GoidaWindow" Height="650" Width="800">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="450"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Frame x:Name="MainFrame" Grid.Row="0" Source="Pages/MainPage.xaml" NavigationUIVisibility="Hidden" Navigating="OnNavigating"/>
        <TextBlock x:Name="Cena"  Grid.Row="1" Margin="300, 0, 0, 0" Height="50" Width="300"  Text=""></TextBlock>
    </Grid>
</Window>
