<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="10" />
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TB" Text="Это текст"></TextBlock>
        
        <TextBlock x:Name="Date" Text="1" Grid.Row="2"></TextBlock>
        <TextBlock x:Name="Year" Text="2" Grid.Row="3"></TextBlock>
        <TextBlock x:Name="Month" Text="3" Grid.Row="4"></TextBlock>
        <TextBlock x:Name="DayOfWeek" Text="4" Grid.Row="5"></TextBlock>
        <Calendar SelectionMode="SingleRange" x:Name="Cal" SelectedDatesChanged="Calendar_SelectedDatesChanged" Grid.Row="1" Width="300" VerticalAlignment="Top"></Calendar>
    </Grid>
</Window>
