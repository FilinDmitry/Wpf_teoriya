<Page x:Class="WpfApp1.Pages.FinalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="FinalPage">

    <Grid>
        <StackPanel Margin="0, 30, 0, 0">
            <Label Content="Заполните личные данные" HorizontalAlignment="Center"></Label>
            <StackPanel Orientation="Horizontal" Margin="200, 10">
                <Label Content="Имя"></Label>
                <TextBox Text="Первоначальный взнос" Width="324"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="200, 10">
                <Label Content="Телефон"></Label>
                <TextBox PreviewTextInput="TextBox_OnPreviewTextInput" Text="Первоначальный взнос" Width="299"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="200, 10">
                <Label Content="Адрес электронной почты"></Label>
                <TextBox Text="Первоначальный взнос" Width="200"></TextBox>
            </StackPanel>
        </StackPanel>
        <Button Content="Оформить заказ" Click="B_click" Margin="340,247,340,63"/>
    </Grid>
</Page>
