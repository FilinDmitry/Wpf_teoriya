<Page x:Class="WpfApp1.Pages.FirstPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="FirstPage">

    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel Margin="260, 0, 0, 0">
                <Label Content="Модель" Margin="0, 40, 0, 0"></Label>
                <RadioButton Content="Седан (400 000)" GroupName="Model" Margin="0, 20, 0, 0"/>
                <RadioButton Content="Кроссовер (1 000 000)" GroupName="Model" Margin="0, 10, 0, 0"/>
                <RadioButton Content="Купе (600 000)" GroupName="Model" Margin="0, 10, 0, 0"/>
                <RadioButton Content="Джип (1 500 000)" GroupName="Model" Margin="0, 10, 0, 0"/>
                <RadioButton Content="Танк (25 000 000)" GroupName="Model" Margin="0, 10, 0, 0"/>
            </StackPanel>
            <StackPanel Margin="100, 0, 0, 0">
                <Label Content="Тип двигателя" Margin="0, 40, 0, 0"></Label>
                <RadioButton Content="Бензиновый (x 1)" GroupName="Engine" Margin="0, 20, 0, 0"/>
                <RadioButton Content="Электрический (x 2)" GroupName="Engine" Margin="0, 20, 0, 0"/>
                <RadioButton Content="Турбореактивный (x 6.5)" GroupName="Engine" Margin="0, 20, 0, 0"/>
            </StackPanel>
        </StackPanel>
        <Button Content="Далее" Click="B_click" Margin="350,247,350,63"/>
    </Grid>
</Page>
