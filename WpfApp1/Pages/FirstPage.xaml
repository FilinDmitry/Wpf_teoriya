<Page x:Class="WpfApp1.Pages.FirstPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="FirstPage">

    <Grid>

        <ListBox x:Name="PizzaListBox" SelectionChanged="PizzaListBox_SelectionChanged" Margin="0,0,0,55" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <Image Height="100" Width="160"  Source="{Binding Directory}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Padding="15" Text="{Binding Price, StringFormat=Цена: {0}}"/>
                            <TextBlock Padding="15" Text="{Binding Name}"/>
                            </StackPanel>
                            <Button Height="40" Content="Добавить в корзину" Click="Button_Click"></Button>
                        </StackPanel>
                    </DataTemplate>
                       
                        
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

        <Button x:Name="Goida" IsEnabled="False" Content="Далее" Click="B_click" Margin="350,300,350,10"/>
    </Grid>
</Page>
