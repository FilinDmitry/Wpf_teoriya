<Page x:Class="WpfApp1.Pages.FirstPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="FirstPage">

    <Grid>
        <ScrollViewer>
            <ListBox x:Name="PizzaListBox" SelectionChanged="PizzaListBox_SelectionChanged" Margin="0,0,0,55">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            
                        <StackPanel>
                            <TextBlock Text="{Binding Price, StringFormat=Цена: {0}}"/>
                            <TextBlock Text="{Binding Description}"/>
                        </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                        
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        <Button x:Name="Goida" IsEnabled="False" Content="Далее" Click="B_click" Margin="350,300,350,10"/>
    </Grid>
</Page>
