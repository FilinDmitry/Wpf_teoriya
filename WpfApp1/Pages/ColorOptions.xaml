<Page x:Class="WpfApp1.Pages.SecondPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="SecondPage">

    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel Margin="230, 0, 0, 0">
                <Label Content="Цвет" Margin="0, 40, 0, 0"></Label>
                <RadioButton Content="Зеленый" GroupName="Color" Margin="0, 20, 0, 0"/>
                <RadioButton Content="Green" GroupName="Color" Margin="0, 10, 0, 0"/>
                <RadioButton Content="HEX #00FF00" GroupName="Color" Margin="0, 10, 0, 0"/>
                <RadioButton Content="RGB (0, 255, 0)" GroupName="Color" Margin="0, 10, 0, 0"/>
                <RadioButton Content="HSV (120°, 100%, 50%)" GroupName="Color" Margin="0, 10, 0, 0"/>
            </StackPanel>
            <StackPanel Margin="100, 0, 0, 0">
                <Label Content="Доп. опции" Margin="0, 40, 0, 0"></Label>
                <CheckBox Content="Подогрев (+ 100 000)" Margin="0, 20, 0, 0"/>
                <CheckBox Content="Кондиционер (+ 1 000 000)" Margin="0, 10, 0, 0"/>
                <CheckBox Content="Возможность ездить (+ 300 000)" Margin="0, 10, 0, 0"/>
                <CheckBox Content="Возможность летать (x 3)" Margin="0, 10, 0, 0"/>
                <CheckBox Content="Возможность плавать (x 1.5)" Margin="0, 10, 0, 0"/>
            </StackPanel>
        </StackPanel>
        <Button Content="Далее" Click="B_click" Margin="350,247,350,63"/>
    </Grid>
</Page>
