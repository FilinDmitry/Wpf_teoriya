<Page x:Class="WpfApp1.Pages.ServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ServicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Margin="20" Grid.Row="1">
            <TextBlock  FontSize="20" Margin="5"  Text="{Binding Type}"></TextBlock>
            <TextBlock FontSize="20" Margin="5" Text="{Binding Date}"></TextBlock>
            <TextBlock  FontSize="20" Margin="5" Text="{Binding Time}"></TextBlock>
            <TextBlock  FontSize="20" Margin="5"  Text="{Binding service.User1.FIO, StringFormat='Мастер: {0}'}"></TextBlock>
            <TextBlock  FontSize="20" Margin="5"  Text="{Binding service.User1.Phone, StringFormat='Телефон мастера: {0}'}"></TextBlock>
            
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="5" Text="Комментарий"></TextBlock>
                <TextBox x:Name="Comment" Width="140" Margin="10"></TextBox>
            </StackPanel>
            <ComboBox x:Name="Oplata" Width="150" Margin="5" HorizontalAlignment="Left"></ComboBox>
            <Button Margin="5" Content="Записатьcя" FontSize="30" HorizontalAlignment="Left" Click="Button_Click"></Button>
        </StackPanel>
    </Grid>
</Page>
