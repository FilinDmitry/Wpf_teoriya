<Page x:Class="WpfApp1.Pages.RegestrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegestrationPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="20*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="1" Text="Укажите логин:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"></TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" Height="50" Width="230" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="2" Text="Укажите пароль:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"></TextBlock>
        <TextBox Grid.Row="2" Grid.Column="1" Height="50" Width="230" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="3" Text="Укажите почту" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"></TextBlock>
        <TextBox Grid.Row="3" Grid.Column="1" Height="50" Width="230" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="4" Text="Укажите имя:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"></TextBlock>
        <TextBox Grid.Row="4" Grid.Column="1" Height="50" Width="230" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="5" Text="Укажите дату рождения:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"></TextBlock>
        <DatePicker Grid.Row="5" Grid.Column="1" Width="230" VerticalAlignment="Center" HorizontalAlignment="Left"></DatePicker>
        <Button Grid.Row="6" Content="Зарегестрироваться" Grid.ColumnSpan="2" Height="50" Width="300"></Button>


    </Grid>
</Page>
