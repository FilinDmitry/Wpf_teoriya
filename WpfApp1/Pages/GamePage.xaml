<Page x:Name="___Без_имени_" x:Class="WpfApp1.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="GamePage">

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="140"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Background="LightGray" BorderThickness="3" Grid.ColumnSpan="3" BorderBrush="Black" CornerRadius="10">
            <TextBlock  HorizontalAlignment="Center" Text="GoidaGame" FontSize="40" FontFamily="Showcard Gothic"  Foreground="DarkOliveGreen"/>
            <!--FontFamily="Calisto MT"-->
        </Border>
        <Border Background="LightGray" BorderThickness="3" Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="Black" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LevelTB" Text="Level: 1" FontSize="20" FontWeight="Bold" FontFamily="Wide Latin" Foreground="DarkGreen"></TextBlock>
                <TextBlock x:Name="HPTB" Margin="30, 0" FontSize="20" Text="HP: -/-"  FontFamily="Wide Latin" FontWeight="Bold" Foreground="#FF6F0000"/>
            </StackPanel>
        </Border>
        
            <StackPanel Orientation="Horizontal" Grid.Row="3">
            <Border Padding="5" Grid.Row="3" Background="LightGray" BorderThickness="5">
                <StackPanel>
                    <Image Height="100" Width="80" Source="/Images/sword.png" Stretch="Fill"/>
                    <TextBlock x:Name="AttackTB" Text="Damage: -" FontFamily="Arial Black" Foreground="#FFAE0101" ></TextBlock>
                </StackPanel>
            </Border>
            <Border Padding="5" Grid.Row="3" Background="LightGray" BorderThickness="5">
                <StackPanel>
                    <Image Height="100" Width="75" Source="/Images/Armor.png" Stretch="Fill"/>
                    <TextBlock x:Name="DefenceTB" Text="Defence: -" FontFamily="Arial Black" Foreground="#FFAE0101" ></TextBlock>
                </StackPanel>
                </Border>
        </StackPanel>
        
        <Border Grid.Row="2" Grid.ColumnSpan="3" CornerRadius="10" Background="Gray" BorderThickness="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                    <ColumnDefinition Width="7*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="7*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="1">
                    <StackPanel>
                        <Image Width="100" Source="/images/Hero.png"/>
                        <!--<ProgressBar Height="7" Width="100" Background="#FFA10A0A"></ProgressBar>-->
                    </StackPanel>
                </Viewbox>
                <Viewbox Grid.Column="3">
                <StackPanel VerticalAlignment="Center" Grid.Column="3">
                        <Image x:Name="EnemyImg" Width="100" Source="/images/1С.jpg" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="EnemyHP" Text="-/-" FontFamily="Wide Latin" HorizontalAlignment="Center" FontSize="10"></TextBlock>
                </StackPanel>
                </Viewbox>
            </Grid>
        </Border>
        <TextBlock x:Name="Logs" TextWrapping="Wrap" Background="Black" Foreground="White" Grid.Column="1" Grid.Row="3" Text="Логи"></TextBlock>
        <StackPanel Grid.Row="3" Grid.Column="2">
            <Button x:Name="AttackBtn" Height="50" Margin="20,5" Content="Attack" FontFamily="Showcard Gothic" FontSize="20" Background="#FFA10A0A" Click="AttackBtn_Click"></Button>
            <Button x:Name="DefendBtn"  Height="50" Margin="20,5" Content="Defend" FontFamily="Showcard Gothic" FontSize="20" Background="#FF042DEA" Click="DefendBtn_Click" ></Button>
        </StackPanel>
    </Grid>
</Page>
