<Page x:Class="WpfApp1.Pages.MenegerPages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages.MenegerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Text="Записи" HorizontalAlignment="Center" FontSize="20"> </TextBlock>
        <TextBlock Text="Заказы0" Grid.Row="2"  HorizontalAlignment="Center" FontSize="20"></TextBlock>
        <ListBox x:Name="ListBoxService"  Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="SeaGreen" BorderThickness="2" CornerRadius="5" Padding="3">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Padding="2" Text="{Binding Date}"/>
                                <TextBlock Padding="2" Text="{Binding Time}"/>
                                <TextBlock Text="{Binding Type}" Padding="10"></TextBlock>
                                <TextBlock Text="{Binding service.User1.FIO, StringFormat=Мастер: {0}}" Padding="10"></TextBlock>
                            </StackPanel>


                        </StackPanel>
                    </Border>
                </DataTemplate>


            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <ListBox x:Name="ListBoxOrder" Grid.Row="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="SeaGreen" BorderThickness="2" CornerRadius="5" Padding="3">
                        <StackPanel Width="250" HorizontalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Padding="2" Text="{Binding Date, StringFormat=dd.MM.yy}"/>
                                <ListBox BorderThickness="0" x:Name="Products" Grid.Row="0" ItemsSource="{Binding OrderProduct}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="LightSeaGreen" BorderThickness="2" Padding="3">
                                                <StackPanel Width="200" HorizontalAlignment="Center">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Margin="5"  Text="{Binding Product.Name, StringFormat=Товар: {0}}"></TextBlock>
                                                        <TextBlock Padding="2" Text="{Binding Amount, StringFormat=Количество {0}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <CheckBox IsEnabled="False" IsChecked="{Binding IsComplete}" Content="Выдан"></CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
