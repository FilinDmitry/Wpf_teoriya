<Page x:Class="WpfApp1.Pages.MenegerPages.ManagerServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages.MenegerPages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="ManagerServicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>
        <ListBox x:Name="ListBox" Grid.Row="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="SeaGreen" BorderThickness="2" CornerRadius="5" Padding="3">
                        <StackPanel Width="250" HorizontalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Type}" Padding="10"></TextBlock>
                                <TextBlock Margin="5"  Text="{Binding service.User.FIO, StringFormat=Клиент: {0}}"></TextBlock>
                                <TextBlock Margin="5"  Text="{Binding service.User1.FIO, StringFormat=Мастер: {0}}"></TextBlock>
                                <TextBlock Padding="2" Text="{Binding service.Date}"/>
                                <Button Content="Записать пользоватея" Margin="3" Click="Button_Click_3"/>
                                <Button Content="Отменить" Margin="3" Click="Button_Click_1"></Button>
                                <Button Content="Перенести" Margin="3" Click="Button_Click"></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <Button Content="Создать новую запись" Grid.Row="1" Click="Button_Click_2"></Button>
    </Grid>
</Page>
