<Page x:Class="WpfApp1.Pages.MenegerPages.ManagerTypeTovarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages.MenegerPages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="ManagerTypeTovarPage">

    <Grid>
        <ListBox x:Name="ListBox" Grid.Row="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="SeaGreen" BorderThickness="2" CornerRadius="5" Padding="3">

                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Margin="5" TextWrapping="Wrap"  Text="Наименование: "></TextBlock>
                            <TextBox TextWrapping="Wrap" TextChanged="TextBox_TextChanged" Width="130" Text="{Binding Name}"></TextBox>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
