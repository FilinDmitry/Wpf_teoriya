<Page x:Class="WpfApp1.Pages.MenegerPages.ManagerOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages.MenegerPages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="ManagerOrderPage">

    <Grid>
        <ListBox x:Name="ListBox" Grid.Row="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="SeaGreen" BorderThickness="2" CornerRadius="5" Padding="3">
                        <StackPanel Width="250" HorizontalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Margin="5"  Text="{Binding User.FIO, StringFormat=Клиент: {0}}"></TextBlock>
                                <TextBlock Padding="2" Text="{Binding Date, StringFormat=dd.MM.yy}"/>
                                <ListBox BorderThickness="0" x:Name="Products" Grid.Row="0" ItemsSource="{Binding OrderProduct}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="LightSeaGreen" BorderThickness="2" Padding="3">
                                                <StackPanel Width="200" HorizontalAlignment="Center">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Margin="5"  Text="{Binding Product.Name, StringFormat=Товар: {0}}"></TextBlock>
                                                        <TextBlock Padding="2" Text="{Binding Amount, StringFormat=Количество {0}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <CheckBox Click="CheckBox_Click" IsChecked="{Binding IsComplete}" Content="Выдан"></CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
