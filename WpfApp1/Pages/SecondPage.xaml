<Page x:Class="WpfApp1.Pages.SecondPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="SecondPage">

    <Grid>
        <ListBox x:Name="CartListBox" Margin="0,0,0,55" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5} ">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center">
                        <Image Height="100" Width="160"  Source="{Binding Directory, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Padding="15" Text="{Binding Price, StringFormat=Цена: {0}, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Padding="15" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Height="40" Content="Удалить из корзины"></Button>
                    </StackPanel>
                </DataTemplate>


            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <Button Content="Оформить заказ"  Height="50" Width="120" VerticalAlignment="Bottom"/>
    </Grid>
</Page>
