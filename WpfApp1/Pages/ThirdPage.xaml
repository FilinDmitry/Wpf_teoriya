<Page x:Class="WpfApp1.Pages.ThirdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="ThirdPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Name="Zakaz"></TextBlock>
        <TextBox x:Name="TB_fio" Grid.Row="1" Margin="230,10,400,20" TextChanged="TextBox_TextChanged"></TextBox>
        <TextBlock Text="Введите ФИО" Grid.Row="1" Margin="30,20,600,20"></TextBlock>
        <TextBox x:Name="TB_pochta" Grid.Row="2" Margin="230,10,400,20" TextChanged="TextBox_TextChanged"></TextBox>
        <TextBlock Text="Введите почту" Grid.Row="2" Margin="30,20,600,20"></TextBlock>
        <TextBox x:Name="TB_adres" Grid.Row="3" Margin="230,10,400,20" TextChanged="TextBox_TextChanged"></TextBox>
        <TextBlock Text="Введите адрес" Grid.Row="3" Margin="30,20,600,20"></TextBlock>
        <Button Name="Final" Grid.Row="4" Content="Оформить заказ" Margin="200,0,200,0" Click="Button_Click" IsEnabled="False"></Button>
    </Grid>
</Page>
