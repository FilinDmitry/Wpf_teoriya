<Window x:Class="WpfApp1.Windows.ServiceCreateNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Windows"
        mc:Ignorable="d"
        Title="ServiceCreateNewWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock x:Name="TB_Master" Text="FIO" FontSize="20" Margin="3" MinWidth="70"></TextBlock>
                <Button Content="Выбрать мастера" FontSize="20" Click="Button_Click"></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock x:Name="TB_Type"  Text="FIO" FontSize="20" Margin="3" MinWidth="70"></TextBlock>
                <Button Content="Выбрать услугу" FontSize="20" Click="Button_Click_1"></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Дата " FontSize="20" Margin="3" Width="70"></TextBlock>
                <DatePicker x:Name="Date" Width="130"></DatePicker>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Время " FontSize="20" Margin="3" Width="70"></TextBlock>
                <TextBox x:Name="Time" Width="200"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Цена " FontSize="20" Margin="3" Width="70"></TextBlock>
                <TextBox x:Name="Price" Width="200"></TextBox>
            </StackPanel>
            <Button Content="Создать" VerticalAlignment="Bottom" Margin="100" Height="40" Width="130" Click="Button_Click_2"></Button>
        </StackPanel>
    </Grid>
</Window>
